# Normalize line endings so the repository looks the same on every platform.
# Without this, a Windows checkout shows every file as modified on Linux.
* text=auto eol=lf

# PowerShell is the exception: Windows tooling expects CRLF for these.
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.webm binary
